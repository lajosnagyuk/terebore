{
  "name": "terebore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/*.ts\" --test-coverage-exclude=\"src/*.test.ts\" --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=90 src/*.test.ts",
    "test:browser": "npm run build && playwright test && node scripts/browser-coverage.mjs",
    "check": "npm run test:coverage && npm run test:browser",
    "format:check": "prettier --check src tests scripts playwright.config.ts",
    "format": "prettier --write src tests scripts playwright.config.ts"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.1.7",
    "wrangler": "4.135.0"
  },
  "description": "A quiet browser game about bouncing colourful balls into a corner.",
  "author": "lajosnagyuk",
  "repository": {
    "type": "git",
    "url": "https://github.com/lajosnagyuk/terebore.git"
  }
}
